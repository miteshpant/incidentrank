# Local Postgres (see docker-compose.yml)
DATABASE_URL="postgres://incidentrank:incidentrank@localhost:5433/incidentrank"

# The application's own public base URL — used anywhere a link is built
# server-side with no browser request to read window.location from
# (transactional email bodies, Stripe Checkout success/cancel redirect
# URLs). Must be set to the real production domain (e.g.
# "https://incidentrank.com", no trailing slash) before any deployed
# environment sends a real email or creates a real Checkout Session —
# otherwise invite links in emails render as a broken relative path and
# Stripe redirects fall back to localhost. Safe to leave as the
# localhost default below for local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Local-dev-only convenience: unlocks paid scenarios in practice mode
# without a real entitlement system. Only takes effect when NODE_ENV is
# not "production" AND the request is actually arriving on localhost —
# setting this on a deployed environment has no effect. Never set this
# in any deployed environment's env config.
DEV_UNLOCK_PAID_SCENARIOS="false"

# Phase 8 — admin bootstrap, promotional access & referral growth loop.
# Feature flags default to false/off until explicitly enabled; server
# mutations are gated on these, never UI visibility alone.
ADMIN_PORTAL_ENABLED="false"
PROMOTIONAL_INVITES_ENABLED="false"
REFERRALS_ENABLED="false"
TRANSACTIONAL_EMAILS_ENABLED="false"

# The exact (case-sensitive, never normalized/plus-address-matched)
# verified email that may bootstrap as the first IncidentRank admin
# owner. Production value is mpant@incidentrank.com. Override only in a
# local/test environment if that exact identity isn't obtainable there
# via Clerk test mode — never add plus-address normalization logic to
# the production comparison.
INITIAL_ADMIN_EMAIL="mpant@incidentrank.com"

# Resend (https://resend.com -> API Keys). Required only once
# TRANSACTIONAL_EMAILS_ENABLED is true; left blank disables real sending
# and a test/no-op email adapter is used instead. Never log or commit
# this value.
RESEND_API_KEY=""

# Phase 9 — Stripe payments (TEST MODE only; see docs/implementation_plan/
# phase9.md). Feature flags default to false/off until explicitly
# enabled; checkout/webhook routes are gated on these server-side, never
# UI visibility alone. Never write real keys here — blank placeholders
# only.
PAYMENTS_ENABLED="false"
STRIPE_CHECKOUT_ENABLED="false"
STRIPE_WEBHOOKS_ENABLED="false"

# Stripe secret key and webhook signing secret. Server-only — never
# exposed to the client. The TEST MODE catalog (Products/Prices below)
# already exists in the Stripe dashboard; this phase never creates
# Stripe objects.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Existing Stripe TEST MODE catalog IDs (IncidentRank Pro product + its
# two recurring prices, IncidentRank Founding Engineer product + its one
# one-time price). The application never accepts a client-supplied price
# ID — only these configured IDs are ever used for checkout or
# recognized when processing webhook events.
STRIPE_PRO_PRODUCT_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
STRIPE_FOUNDING_PRODUCT_ID=""
STRIPE_FOUNDING_LIFETIME_PRICE_ID=""

# Phase 10B — organization assessment credits & billing (TEST MODE only;
# see docs/implementation_plan/phase10b.md). Separate catalog from the
# individual Pro/Founding products above — never reused for organization
# purchases. Feature flags default to false/off; checkout/webhook/
# consumption routes are gated on these server-side, never UI visibility
# alone. Disabling purchase must never erase existing credits.
ORG_BILLING_ENABLED="false"
ORG_CREDIT_PURCHASE_ENABLED="false"
ORG_CREDIT_CONSUMPTION_ENABLED="false"

# Organization credit Stripe TEST MODE catalog IDs (IncidentRank
# Assessment Credit, $50 one-time; IncidentRank Assessment Credit Pack,
# $5,000/110 credits one-time). Never accepted from the client — only
# these configured IDs are ever used for organization checkout or
# recognized when processing organization-credit webhook events.
STRIPE_ORG_SINGLE_CREDIT_PRODUCT_ID=""
STRIPE_ORG_SINGLE_CREDIT_PRICE_ID=""
STRIPE_ORG_CREDIT_PACK_PRODUCT_ID=""
STRIPE_ORG_CREDIT_PACK_PRICE_ID=""

# Phase 10C — Engineer Rank (see docs/implementation_plan/phase10c.md).
# Gates rank-snapshot recalculation, the profile panel, the admin rebuild
# route, and the global leaderboard — never scoring itself. Default
# false/off; every gated route checks this server-side.
ENGINEER_RANK_ENABLED="false"

# Phase 10D — legal acceptance gate (see docs/implementation_plan/
# phasse10d.md §28). ISO timestamp; a user is gated to /legal/accept
# only if their users.createdAt is at/after this instant — existing
# users from before this instant are deliberately NEVER retroactively
# gated (confirmed product decision). Unset/invalid defaults to a
# far-future date, i.e. "gate no one" — never leave this unset in an
# environment where the gate is actually meant to be live; set it to
# the real cutover instant before enabling in production.
LEGAL_ACCEPTANCE_GATE_CUTOVER_AT=""

# Phase 10E — launch discount promotion (see docs/implementation_plan/
# phase10e.md). Default false/off: normal list pricing. When true, an
# eligible checkout (per the server-side first-purchase/no-existing-
# entitlement checks) receives the configured launch coupon below.
# Discount validity never affects entitlement validity after purchase —
# disabling this flag only stops NEW checkouts from receiving a
# discount, it never revokes anything already granted.
LAUNCH_DISCOUNTS_ENABLED="false"

# Launch-discount Stripe TEST MODE coupon IDs. Never accepted from the
# client — the server resolves plan -> coupon ID from these configured
# values only. Pro Monthly: 75% off, duration=repeating,
# duration_in_months=3. Pro Annual / Founding / Org first-purchase: 50%
# off, duration=once.
STRIPE_PRO_MONTHLY_LAUNCH_COUPON_ID=""
STRIPE_PRO_ANNUAL_LAUNCH_COUPON_ID=""
STRIPE_FOUNDING_LAUNCH_COUPON_ID=""
STRIPE_ORG_FIRST_PURCHASE_COUPON_ID=""
