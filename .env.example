# Local Postgres (see docker-compose.yml)
DATABASE_URL="postgres://incidentrank:incidentrank@localhost:5433/incidentrank"

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Local-dev-only convenience: unlocks paid scenarios in practice mode
# without a real entitlement system. Only takes effect when NODE_ENV is
# not "production" AND the request is actually arriving on localhost —
# setting this on a deployed environment has no effect. Never set this
# in any deployed environment's env config.
DEV_UNLOCK_PAID_SCENARIOS="false"
